# Cerebrus AI - Environment Variables
# Copy this file to .env and fill in your API keys

# Agora Conversational AI Configuration
AGORA_APP_ID=your_app_id_here
AGORA_CUSTOMER_ID=your_customer_id_here
AGORA_CUSTOMER_SECRET=your_customer_secret_here
AGORA_RTC_TOKEN=your_rtc_token_here

# LLM Configuration (choose one)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Azure Speech Services (for voice AI)
AZURE_TTS_API_KEY=your_azure_tts_api_key_here
AZURE_ASR_API_KEY=your_azure_asr_api_key_here
AZURE_SPEECH_REGION=eastus

# Elasticsearch (optional - will use InMemory if not configured)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_NAME=cerebrus_documents

# Webhook Server Configuration
WEBHOOK_PORT=8000
WEBHOOK_HOST=0.0.0.0

# Instructions:
# 1. Create an Agora account at https://console.agora.io
# 2. Create a project and enable Conversational AI
# 3. Get your App ID, Customer ID, and Customer Secret
# 4. Generate RTC tokens for authentication
# 5. Get OpenAI API key from https://platform.openai.com/api-keys
# 6. Get Azure Speech Service keys from https://portal.azure.com
# 7. Save this file as .env (remove .template from filename)